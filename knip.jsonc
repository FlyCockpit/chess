{
  "$schema": "https://unpkg.com/knip@latest/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        // Shell/image dispatch and the owned Prisma subprocess use paths.
        "scripts/backup/{lib,s3,restore,schedule,drill}.mjs!",
        "scripts/db/migrate-runtime.mjs!",
        "scripts/db/lib/prisma-owner.mjs!",
        // The local database guard invokes this CLI by filename.
        "scripts/db/lib/local-db-name.mjs!",
        "scripts/build-commit.mjs!",
        "scripts/trufflehog-pr-scan.sh!",
        // Structural destructive-operation scanner — invoked by policy-checks.sh.
        "scripts/check-destructive-operations.mjs!",
        // Agent-rules gate (route exports / t() coverage / sitemap sync) —
        // invoked by policy-checks.sh, not statically imported.
        "scripts/check-agent-rules.ts!",
        // Run by every Dockerfile to install the packageManager-pinned pnpm.
        "scripts/install-pnpm.mjs!",
        // Child Vitest config — passed dynamically to the I/O-guard fixture test.
        "scripts/vitest-test-io-guard-fixture.config.ts!"
      ],
      "ignoreBinaries": [
        // Global local-dev CLI. Intentionally not listed in package.json.
        "portless",
        // PostgreSQL client tools supplied by the host / runtime images.
        "psql",
        "pg_restore"
      ]
    },
    "packages/chess": {
      "ignoreDependencies": [
        // Loaded at runtime by path: engine.ts spawns the file returned by
        // createRequire(...).resolve("stockfish/bin/..."), which knip can't trace.
        "stockfish"
      ]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx!"],
      "ignoreDependencies": [
        // Imported only via PostCSS/Tailwind CSS pipeline, not statically.
        "tailwindcss",
        "postcss",
        // Consumed indirectly via `@orpc/client` + `createORPCClient`.
        "@orpc/server",
        // Toast primitive re-exported from @cockpit-chess/ui.
        "sileo",
        // Optional peer of h3 2.x (pulled by TanStack Start); pinned here so the
        // SSR/oRPC stack binds crossws 0.4.x instead of the 0.3.x h3 1.x dedupes
        // to. No static import in source — it's a build/runtime transitive.
        "crossws",
        // SSR inlines auth/db; external drivers resolve from web at runtime.
        "pg",
        "@prisma/client"
      ]
    },
    "apps/server": {
      // better-auth is consumed via @cockpit-chess/auth; declared directly so the
      // native binary / auth handler graph stays in this app's deploy image.
      "ignoreDependencies": ["better-auth"]
    },
    "apps/worker": {},
    "packages/ui": {
      "entry": ["src/components/**/*.tsx", "src/styles/**/*.css"]
    },
    "packages/api": {
      "ignoreDependencies": ["@orpc/client", "@orpc/openapi", "@orpc/zod"]
    },
    "packages/db": {
      "ignoreDependencies": ["@prisma/client", "pg", "zod"]
    },
    "packages/auth": {
      "ignoreDependencies": ["zod"]
    }
  }
}
