/// A complete replay archive. Public readers always filter published=true.
model ChessMatch {
  id                   String    @id @default(cuid(2))
  slug                 String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  ownerId              String
  Owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title                String
  whiteName            String
  blackName            String
  status               String    @default("draft")
  published            Boolean   @default(false)
  official             Boolean   @default(false)
  source               String    @default("hosted")
  rulesKey             String
  /// The archive's ruleset version (`config.rules.version`). Rows under a version this
  /// build no longer reads list as "old rules" and are never parsed for replay.
  rulesVersion         String?
  contextMode          String
  identityMode         String
  runToken             String?
  heartbeatAt          DateTime?
  archive              Json
  /// Leaderboard stats, derived once from the archive on its terminal write
  /// (apps/worker persist, chess.importGame). Null until the match finishes;
  /// readers skip rows without them instead of re-parsing archives.
  result               String?
  whiteModel           String?
  whiteProtocol        String?
  blackModel           String?
  blackProtocol        String?
  whiteIllegal         Int?
  blackIllegal         Int?
  /// Of the rejected attempts, replies cut off at their output limit ("truncated").
  whiteTruncated       Int?
  blackTruncated       Int?
  /// Usage-based cost in micros (integer minor units). Null = unknown cost.
  whiteCostMicros      BigInt?
  blackCostMicros      BigInt?
  /// The ruleset's move format ("strict" | "lenient"), denormalized for leaderboard labels.
  moveFormat           String?
  /// How the match ended, as the short summary match cards show
  /// (`endingSummarySchema` in packages/chess/src/ending.ts). Written with the stats
  /// columns on the terminal write; null while running.
  ending               Json?
  /// Spectator-only engine scores of the game's positions, keyed by ply
  /// (`spectatorEvaluationsSchema` in packages/chess/src/spectator.ts). Written in the
  /// background, merged key by key; never part of the archive or the players' context.
  spectatorEvaluations Json?
  /// Whose OpenRouter key pays for the players: "operator" (the server's
  /// OPENROUTER_API_KEY, admin matches only) or "owner-openrouter" (the match
  /// owner's connected key, loaded by owner at claim time; never the operator key).
  credentialSource     String    @default("operator")

  @@index([published, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@index([status, createdAt])
  @@map("chess_match")
}

/// A user's own OpenRouter key, from OpenRouter's OAuth PKCE flow
/// (apps/server/src/openrouter-routes.ts). One per user. The key is sealed with
/// AES-256-GCM under CHESS_PROVIDER_KEY_SECRET, with the user id as associated
/// data (packages/api/src/lib/provider-key.ts); it never leaves the server or
/// worker. Everything else here is safe to show its owner.
model OpenRouterConnection {
  id            String    @id @default(cuid(2))
  userId        String    @unique
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  /// AES-256-GCM ciphertext followed by its 16-byte tag.
  keyCiphertext Bytes
  /// The 12-byte random nonce.
  keyNonce      Bytes
  /// Which secret sealed the row: the first 16 hex of SHA-256 of the secret.
  keySecretId   String
  /// SHA-256 hex of the key: OpenRouter's key page is openrouter.ai/keys/<hash>.
  keyHash       String
  /// The key's last four characters, for "sk-or-v1-…abcd".
  keyHint       String
  label         String?
  /// The key's spend limit in micros (integer USD millionths); null = no limit.
  limitMicros   BigInt?
  expiresAt     DateTime?
  /// "active", or "invalid" once OpenRouter refused the key (revoked or expired).
  status        String    @default("active")
  lastCheckedAt DateTime  @default(now())

  @@map("openrouter_connection")
}
