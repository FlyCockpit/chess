/// A complete replay archive. Public readers use the centralized visibility predicate.
model ChessMatch {
  id                   String                  @id @default(cuid(2))
  publicId             String                  @unique @default(dbgenerated("(gen_random_uuid())::text"))
  slug                 String                  @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @default(now()) @updatedAt
  ownerId              String?
  Owner                User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title                String
  whiteName            String
  blackName            String
  status               String                  @default("draft")
  published            Boolean                 @default(false)
  /// Publication belongs to the uploader; only administrators can change this independent fence.
  hiddenAt             DateTime?
  moderationReason     ChessModerationReason?
  /// The administrator's statement of reasons, visible to the uploader, never report text.
  moderationNote       String?
  moderationVersion    Int                     @default(0)
  Reports              ChessReplayReport[]
  ModerationActions    ChessModerationAction[]
  OfficialEntry        ChessOfficialEntry?
  Creation             ChessCreation?
  source               String                  @default("hosted")
  rulesKey             String
  /// Current archives use cockpit-v1. Unsupported versions have no replay.
  rulesVersion         String?
  /// Code-shipped bundle pin; immutable once accepted. No inferred provenance for prelaunch rows.
  promptVersion        String?
  promptHash           String?
  contextMode          String
  identityMode         String
  runToken             String?
  heartbeatAt          DateTime?
  /// Internal turn state: idle | model (claimed) | human (parked) | human-move (ready).
  /// Human waits/ready inputs have no runToken and consume no worker slot.
  turnType             String                  @default("idle")
  turnId               String?
  turnSide             String?
  turnExpectedSeq      Int?
  turnStartedAt        DateTime?
  turnDeadline         DateTime?
  /// One bounded UCI input + server receipt time; never a list or inference context.
  pendingMove          Json?
  archive              Json
  /// Leaderboard stats, derived once from the archive on its terminal write
  /// (apps/worker persist, chess.importGame). Null until the match finishes;
  /// readers skip rows without them instead of re-parsing archives.
  result               String?
  whiteModel           String?
  whiteProtocol        String?
  blackModel           String?
  blackProtocol        String?
  whiteIllegal         Int?
  blackIllegal         Int?
  /// Of the rejected attempts, replies cut off at their output limit ("truncated").
  whiteTruncated       Int?
  blackTruncated       Int?
  /// Usage-based cost in micros (integer minor units). Null = unknown cost.
  whiteCostMicros      BigInt?
  blackCostMicros      BigInt?
  /// The ruleset's move format ("strict" | "lenient"), denormalized for leaderboard labels.
  moveFormat           String?
  /// How the match ended, as the short summary match cards show
  /// (`endingSummarySchema` in packages/chess/src/ending.ts). Written with the stats
  /// columns on the terminal write; null while running.
  ending               Json?
  /// Server-owned terminal cause; never supplied by clients or imported archives.
  terminalCause        String?
  /// Spectator-only engine scores of the game's positions, keyed by ply
  /// (`spectatorEvaluationsSchema` in packages/chess/src/spectator.ts). Written in the
  /// background, merged key by key; never part of the archive or the players' context.
  spectatorEvaluations Json?
  /// Whose OpenRouter key pays for the players: "operator" (the server's
  /// OPENROUTER_API_KEY, admin matches only) or "owner-openrouter" (the match
  /// owner's connected key, loaded by owner at claim time; never the operator key).
  credentialSource     String                  @default("operator")

  @@index([hiddenAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([published, createdAt(sort: Desc), id(sort: Desc)])
  @@index([published, createdAt(sort: Desc), publicId(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([promptVersion, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, heartbeatAt])
  @@index([turnType, turnDeadline, id])
  @@index([status, createdAt])
  @@map("chess_match")
}

/// Private idempotency receipt. Its id hashes owner + random creation key; no raw owner,
/// title, slug or configuration is retained here. Deletion cannot reuse an accepted key.
model ChessCreation {
  id           String      @id
  configDigest String
  matchId      String?     @unique
  Match        ChessMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@map("chess_creation")
}

/// Permanent minimal public official commitment. Never copy owner/title/name/reply text.
/// Enrollment is immutable; only pending -> terminal settlement may update outcome fields.
model ChessOfficialEntry {
  id                  String      @id @default(cuid(2))
  matchId             String?     @unique
  Match               ChessMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  startedAt           DateTime    @default(now())
  promptVersion       String
  promptHash          String
  rulesKey            String
  rules               Json
  initialFen          String
  initialPositionHash String
  scopeKey            String
  billingCohort       String
  opponentType        String
  whiteModel          String
  whiteProtocol       String
  blackModel          String
  blackProtocol       String
  moveFormat          String
  state               String      @default("pending")
  cause               String?
  settledAt           DateTime?
  result              String?
  finalFen            String?
  whiteIllegal        Int?
  blackIllegal        Int?
  whiteTruncated      Int?
  blackTruncated      Int?
  whiteCostMicros     BigInt?
  blackCostMicros     BigInt?

  @@index([startedAt(sort: Desc), id(sort: Desc)])
  @@index([promptVersion, rulesKey, initialPositionHash, billingCohort, opponentType])
  @@index([scopeKey])
  @@map("chess_official_entry")
}

/// A user's own OpenRouter key, from OpenRouter's OAuth PKCE flow
/// (apps/server/src/openrouter-routes.ts). One per user. The key is sealed with
/// AES-256-GCM under CHESS_PROVIDER_KEY_SECRET, with the user id as associated
/// data (packages/api/src/lib/provider-key.ts); it never leaves the server or
/// worker. Everything else here is safe to show its owner.
model OpenRouterConnection {
  id            String    @id @default(cuid(2))
  userId        String    @unique
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  /// AES-256-GCM ciphertext followed by its 16-byte tag.
  keyCiphertext Bytes
  /// The 12-byte random nonce.
  keyNonce      Bytes
  /// Which secret sealed the row: the first 16 hex of SHA-256 of the secret.
  keySecretId   String
  /// SHA-256 hex of the key: OpenRouter's key page is openrouter.ai/keys/<hash>.
  keyHash       String
  /// The key's last four characters, for "sk-or-v1-…abcd".
  keyHint       String
  label         String?
  /// The key's spend limit in micros (integer USD millionths); null = no limit.
  limitMicros   BigInt?
  expiresAt     DateTime?
  /// "active", or "invalid" once OpenRouter refused the key (revoked or expired).
  status        String    @default("active")
  lastCheckedAt DateTime  @default(now())

  @@map("openrouter_connection")
}

/// Fixed categories only; free-text reports and uploader statements are separately bounded.
enum ChessModerationReason {
  privacy
  harassment
  illegal_content
  spam
  other
  no_violation
}

/// No transcript or raw IP. Reporter deletion erases the report and its notes.
model ChessReplayReport {
  id         String                @id @default(cuid(2))
  createdAt  DateTime              @default(now())
  matchId    String
  Match      ChessMatch            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporterId String?
  Reporter   User?                 @relation("ChessReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  /// Purpose-bound HMAC of replay + daily IP identity; never the raw IP address.
  dedupKey   String                @unique
  reason     ChessModerationReason
  note       String?
  reviewedAt DateTime?

  @@index([matchId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([reporterId, id])
  @@index([reviewedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@map("chess_replay_report")
}

/// Administrative decisions survive actor deletion as minimal moderation evidence.
/// Match deletion removes its history; no copied archive or reporter identity is retained.
model ChessModerationAction {
  id        String                @id @default(cuid(2))
  createdAt DateTime              @default(now())
  matchId   String
  Match     ChessMatch            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actorId   String?
  Actor     User?                 @relation("ChessModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  hidden    Boolean
  reason    ChessModerationReason
  /// Separately authored statement of reasons; never automatically copied from a report.
  note      String

  @@index([matchId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, id])
  @@map("chess_moderation_action")
}
