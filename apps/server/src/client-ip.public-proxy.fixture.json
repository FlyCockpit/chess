    "socket": "fd00::2",
    "xff": "2001:db8::443, 2001:db8:1::10",
    "expectedClientIp": "2001:db8::443"
  },
  {
    "id": "edge-traefik-short-chain",
    "hops": 2,
    "socket": "10.0.0.2",
    "xff": "192.0.2.10",
    "headers": { "cf-connecting-ip": "198.51.100.7" },
    "expectedClientIp": "10.0.0.2"
  },
  {
    "id": "edge-traefik-invalid-selected-entry",
