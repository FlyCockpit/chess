    "headers": {
      "cf-connecting-ip": "203.0.113.200",
      "true-client-ip": "203.0.113.200",
      "x-real-ip": "203.0.113.200",
      "forwarded": "for=203.0.113.200"
    },
    "expectedClientIp": "198.51.100.7"
  },
  {
    "id": "edge-traefik-ipv4-port",
    "hops": 2,
    "socket": "10.0.0.2",
