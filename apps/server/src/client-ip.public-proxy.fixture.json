[
  {
    "id": "edge-traefik-ipv4",
    "hops": 2,
    "socket": "10.0.0.2",
    "xff": "198.51.100.7, 192.0.2.10",
    "expectedClientIp": "198.51.100.7"
  },
  {
    "id": "edge-traefik-ipv6",
    "hops": 2,
